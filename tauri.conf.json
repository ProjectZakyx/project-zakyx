{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "dist",
    "distDir": "dist"
  },
  "package": {
    "productName": "Ora Browser",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": false,
      "identifier": "com.ora.browser",
      "icon": [
        "icons/ora16x16.ico",
        "icons/ora24x24.ico", 
        "icons/ora32x32.ico",
        "icons/ora48x48.ico",
        "icons/ora64x64.ico",
        "icons/ora96x96.ico",
        "icons/ora128x128.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Ora Browser",
        "width": 1200,
        "url": "index.html"
      }
    ]
  }
} 